{
  "compilerOptions": {
    "target": "esnext",
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "module": "nodenext",
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
    // "noImplicitAny": true, // makes it mandatory to have types for all variables used.
    // "noEmit": true,
    // "types": ["node"],
    // "allowImportingTsExtensions": true
  }
}
